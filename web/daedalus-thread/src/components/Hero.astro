---
/**
 * Custom Starlight Hero component override.
 * Replaces static logo with the 3D parametric morphing airframe visualization
 * and highlights rapid (< 48h) fixed-wing sUAS fielding.
 */
import { LinkButton } from '@astrojs/starlight/components';
import AirframeViewer from './hero/AirframeViewer.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, actions = [] } = data.hero || {};
---

<div class="dt-hero-section">
  <div class="dt-hero-grid">
    <!-- Left Column: Mission Content & Value Proposition -->
    <div class="dt-hero-content">
      <h1 class="dt-hero-title">{title}</h1>

      <p class="dt-hero-highlight">
        Mission Requirements to Airborne in <span class="dt-accent-gradient">&lt; 48 Hours</span>
      </p>

      <p class="dt-hero-description">
        An open-source digital thread connecting SysML mission requirements directly to automated aerodynamic sizing, generative CAD, and agile additive fabrication.
      </p>

      <!-- Core Benchmark Highlights -->
      <div class="dt-metrics-pills">
        <div class="dt-metric-pill">
          <span class="dt-metric-val">&lt; 48h</span>
          <span class="dt-metric-lbl">Wing Fabrication</span>
        </div>
        <div class="dt-metric-pill">
          <span class="dt-metric-val">&lt; 4h</span>
          <span class="dt-metric-lbl">SysML to CAD</span>
        </div>
        <div class="dt-metric-pill">
          <span class="dt-metric-val">±1.5mm</span>
          <span class="dt-metric-lbl">Twin Precision</span>
        </div>
        <div class="dt-metric-pill">
          <span class="dt-metric-val">&gt; 60%</span>
          <span class="dt-metric-lbl">NRE Reduction</span>
        </div>
      </div>

      <!-- Action Buttons -->
      {actions.length > 0 && (
        <div class="dt-hero-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
            </LinkButton>
          ))}
        </div>
      )}
    </div>

    <!-- Right Column: Stylized 3D Aerodynamic Morphing Viewer -->
    <div class="dt-hero-visual">
      <AirframeViewer />
    </div>
  </div>
</div>

<style>
  .dt-hero-section {
    position: relative;
    padding-top: 1rem;
    padding-bottom: 2rem;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: 1rem;
  }

  /* Narrow viewports: single column centered stack */
  .dt-hero-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }

  .dt-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.15rem;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .dt-hero-visual {
    position: relative;
    width: 100%;
    max-width: 580px;
    height: 420px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 5;
    background: radial-gradient(circle at 50% 50%, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.2) 100%);
    border: 1px solid rgba(56, 189, 248, 0.18);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  :root[data-theme='light'] .dt-hero-visual {
    background: radial-gradient(circle at 50% 50%, rgba(241, 245, 249, 0.8) 0%, rgba(226, 232, 240, 0.5) 100%);
    border-color: rgba(2, 132, 199, 0.25);
    box-shadow: 0 10px 25px -10px rgba(0, 0, 0, 0.08);
  }

  /* Wide viewports (Desktop): True side-by-side dual-column cockpit grid */
  @media (min-width: 62rem) {
    .dt-hero-section {
      min-height: 520px;
      display: flex;
      align-items: center;
      padding-top: 1.5rem;
      padding-bottom: 2.5rem;
      padding-inline: 1.5rem;
    }

    .dt-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
      align-items: center;
      gap: 2.5rem;
      width: 100%;
      min-height: 500px;
    }

    .dt-hero-content {
      align-items: flex-start;
      text-align: left;
      width: 100%;
      max-width: 54ch;
      margin: 0;
      padding-right: 0.5rem;
    }

    .dt-hero-title,
    .dt-hero-highlight,
    .dt-hero-description {
      text-align: left;
    }

    .dt-hero-description {
      margin: 0;
    }

    .dt-metrics-pills,
    .dt-hero-actions {
      justify-content: flex-start;
      max-width: 100%;
    }

    .dt-hero-visual {
      position: relative;
      width: 100%;
      height: 480px;
      max-width: none;
      margin: 0;
      transform: none;
      right: auto;
      top: auto;
    }
  }

  .dt-hero-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--sl-color-white);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .dt-hero-highlight {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-gray-1);
    margin: 0;
  }

  .dt-accent-gradient {
    background: linear-gradient(120deg, #38bdf8 0%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
  }

  :root[data-theme='light'] .dt-accent-gradient {
    background: linear-gradient(120deg, #0284c7 0%, #4f46e5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .dt-hero-description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    max-width: 54ch;
    margin: 0 auto;
  }

  .dt-metrics-pills {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    max-width: 480px;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .dt-metric-pill {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.4rem 0.3rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.6rem;
  }

  :root[data-theme='light'] .dt-metric-pill {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.08);
  }

  .dt-metric-val {
    font-size: clamp(0.85rem, 1.15vw, 1.05rem);
    font-weight: 700;
    color: #38bdf8;
    line-height: 1.2;
    white-space: nowrap;
  }

  :root[data-theme='light'] .dt-metric-val {
    color: #0284c7;
  }

  .dt-metric-lbl {
    font-size: clamp(0.55rem, 0.72vw, 0.68rem);
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* Action Buttons: Clean 2-button layout with primary overview & secondary repo */
  .dt-hero-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    width: 100%;
    max-width: 440px;
  }

  .dt-hero-actions :global(.sl-link-button) {
    white-space: nowrap !important;
    padding: 0.55rem 1.15rem !important;
    font-size: 0.88rem !important;
    font-weight: 600 !important;
    border-radius: 0.45rem !important;
    transition: all 0.15s ease !important;
  }

  /* Primary button style */
  .dt-hero-actions :global(.sl-link-button.primary) {
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;
    color: #ffffff !important;
    border: 1px solid rgba(56, 189, 248, 0.4) !important;
    box-shadow: 0 4px 15px rgba(2, 132, 199, 0.3) !important;
  }

  .dt-hero-actions :global(.sl-link-button.primary:hover) {
    background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%) !important;
    box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4) !important;
    transform: translateY(-1px) !important;
  }

  /* Secondary button style */
  .dt-hero-actions :global(.sl-link-button.secondary),
  .dt-hero-actions :global(.sl-link-button.minimal),
  .dt-hero-actions :global(.sl-link-button:not(.primary)) {
    background: rgba(15, 23, 42, 0.6) !important;
    border: 1px solid rgba(148, 163, 184, 0.25) !important;
    color: var(--sl-color-gray-2) !important;
    backdrop-filter: blur(8px) !important;
  }

  :root[data-theme='light'] .dt-hero-actions :global(.sl-link-button:not(.primary)) {
    background: rgba(241, 245, 249, 0.8) !important;
    border-color: rgba(148, 163, 184, 0.35) !important;
    color: var(--sl-color-gray-1) !important;
  }

  .dt-hero-actions :global(.sl-link-button:not(.primary):hover) {
    border-color: #38bdf8 !important;
    color: var(--sl-color-white) !important;
    background: rgba(56, 189, 248, 0.1) !important;
  }
</style>
